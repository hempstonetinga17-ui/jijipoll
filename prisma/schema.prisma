// Add VisitorLog model to existing schema
// Run: npx prisma db push after this change

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AgentVisit {
  id              String   @id @default(cuid())
  agentCardId     String   // BusinessCard.id of the agent
  leadId          String?  // If visit is linked to a specific lead
  latitude        Float
  longitude       Float
  locationAddress String?
  locationLabel   String?  // e.g., "Shell Petrol Station, Westlands"
  visitNote       String?
  durationMins    Int?
  outcome         String   @default("VISITED") // "VISITED", "NO_ANSWER", "FOLLOW_UP", "CONVERTED"
  photos          String[] @default([]) // Supabase storage URLs
  createdAt       DateTime @default(now())
}

model FieldPhoto {
  id          String   @id @default(cuid())
  agentCardId String
  leadId      String?
  visitId     String?
  photoUrl    String
  caption     String?
  type        String   @default("STOREFRONT") // "STOREFRONT", "DOCUMENT", "RECEIPT", "OTHER"
  latitude    Float?
  longitude   Float?
  createdAt   DateTime @default(now())
}

model FieldAccount {
  id              String   @id @default(cuid())
  name            String
  address         String?
  latitude        Float
  longitude       Float
  
  // Sales specific fields
  status          String   @default("PROSPECT") // PROSPECT, CUSTOMER, CHURNED
  salesStage      String   @default("NEW") // NEW, QUALIFIED, NEGOTIATING, CLOSED_WON
  salesYTD        Float    @default(0)
  nextStep        String?  // e.g. "phone call", "drop off a sample"
  nextStepDate    DateTime?
  daysSinceVisit  Int      @default(0)
  priority        String   @default("Medium") // High, Medium, Low
  
  // Organization / Agent mapping
  agentCardId     String?  // ID of the assigned field rep
  orgId           String?  // ID of the organization
  
  customFields    Json?    // For flexibility (Specialty, Customer Type, etc.)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  phoneNumber   String?   @unique // Added for Field Agents
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  role          String    @default("USER") // USER, AGENT, SUPERVISOR, BUSINESS_OWNER, ADMIN, ANNOTATOR, LINGUIST, EVALUATOR
  status        String    @default("TRAINING") // PENDING, TRAINING, ACTIVE, FLAGGED, SUSPENDED
  points        Int       @default(0) // 1 point = 1 Ksh for agents
  averageGrade  Float     @default(0) // 0 to 100% average of graded submissions
  
  accounts      Account[]
  sessions      Session[]
  business      Business?
  submissions   DataSubmission[] // Submissions by this agent
  audioSubmissions  AudioSubmission[]
  textSubmissions   TextSubmission[]
  videoSubmissions  VideoSubmission[]
  evalSubmissions   EvalSubmission[]
  annotations       Annotation[]
  withdrawals   WithdrawalRequest[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Business {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String
  description String?
  latitude    Float?
  longitude   Float?
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model VisitorLog {
  id          String   @id @default(cuid())
  ip          String?
  country     String?
  city        String?
  region      String?
  latitude    Float?
  longitude   Float?
  userAgent   String?
  device      String?  // "mobile", "tablet", "desktop"
  page        String?
  consentLevel String  @default("essential") // "essential", "analytics", "full"
  createdAt   DateTime @default(now())
}

model DataSubmission {
  id              String   @id @default(cuid())
  agentId         String
  agent           User     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  
  latitude        Float
  longitude       Float
  
  category        String   // "BUSINESS", "WATER_FEATURE", "CHURCH", "BUILDING", "OTHER"
  photoUrl        String   // Cloudflare R2 URL
  
  contactInfo     String?
  customFeatures  Json?    // Optional extra data (e.g. software used, open hours)
  
  status          String   @default("PENDING") // PENDING, VERIFIED, REJECTED
  feedback        String?  // Feedback from supervisor for rejected or verified submissions
  grade           Int?     // Percentage grade (0-100)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model WithdrawalRequest {
  id          String   @id @default(cuid())
  agentId     String
  agent       User     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  amount      Int
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// AI DATA COLLECTION PLATFORM MODELS
// ─────────────────────────────────────────────────────────────

model Language {
  id          String   @id @default(cuid())
  code        String   @unique // e.g. "sw", "ki", "luo"
  name        String   // e.g. "Swahili"
  nativeName  String?  // e.g. "Kiswahili"
  region      String?  // e.g. "East Africa"
  country     String?  // e.g. "Kenya"
  isLowResource Boolean @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  audioSubmissions AudioSubmission[]
  textSubmissions  TextSubmission[]
  tasks            CollectionTask[]
}

model CollectionTask {
  id              String   @id @default(cuid())
  title           String
  description     String?
  taskType        String   // "AUDIO", "TEXT", "VIDEO", "PHOTO", "EVAL"
  domain          String?  // "agriculture", "law", "health", "education", "finance", "public"
  languageId      String?
  language        Language? @relation(fields: [languageId], references: [id])

  // Script/prompt bank (array of strings agents are shown)
  prompts         String[] @default([])

  // Targeting
  targetCount     Int      @default(100)  // Total submissions needed
  rewardPerItem   Int      @default(5)    // KES per approved submission
  deadline        DateTime?

  // Status
  status          String   @default("ACTIVE") // "DRAFT", "ACTIVE", "PAUSED", "CLOSED"
  isPublic        Boolean  @default(true) // If true, all agents see it; else assigned

  audioSubmissions AudioSubmission[]
  textSubmissions  TextSubmission[]
  videoSubmissions VideoSubmission[]
  evalSubmissions  EvalSubmission[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AudioSubmission {
  id              String   @id @default(cuid())
  agentId         String
  agent           User     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  taskId          String?
  task            CollectionTask? @relation(fields: [taskId], references: [id])

  // Language metadata
  languageId      String?
  language        Language? @relation(fields: [languageId], references: [id])
  dialect         String?   // e.g. "Coastal Swahili", "Sheng"

  // Recording
  audioUrl        String    // Cloudflare R2 URL
  durationSecs    Float?
  scriptPrompt    String?   // The sentence the agent was given
  isScripted      Boolean   @default(true)

  // Context
  audioType       String   @default("MONOLOGUE") // "MONOLOGUE", "DIALOGUE", "CALL_CENTER"
  environment     String   @default("INDOOR")    // "INDOOR", "OUTDOOR", "NOISY", "QUIET"
  speakerGender   String?  // "MALE", "FEMALE", "OTHER"
  speakerAge      String?  // "18-25", "26-35", "36-50", "50+"

  latitude        Float?
  longitude       Float?

  // Quality
  status          String   @default("PENDING")
  grade           Int?
  feedback        String?
  annotations     Annotation[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model TextSubmission {
  id              String   @id @default(cuid())
  agentId         String
  agent           User     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  taskId          String?
  task            CollectionTask? @relation(fields: [taskId], references: [id])

  languageId      String?
  language        Language? @relation(fields: [languageId], references: [id])
  sourceLanguage  String?

  textType        String   @default("CORPUS") // "CORPUS", "TRANSLATION", "RLHF_PROMPT", "TRANSCRIPTION"
  domain          String?

  sourceText      String?  @db.Text
  submittedText   String   @db.Text

  conversationTurn Int?    @default(1)
  parentId        String?

  status          String   @default("PENDING")
  grade           Int?
  feedback        String?
  phoneticNotes   String?
  annotations     Annotation[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model VideoSubmission {
  id              String   @id @default(cuid())
  agentId         String
  agent           User     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  taskId          String?
  task            CollectionTask? @relation(fields: [taskId], references: [id])

  videoUrl        String
  thumbnailUrl    String?
  durationSecs    Float?

  activityLabel   String?
  sceneType       String?
  isEgocentric    Boolean  @default(false)
  objectLabels    String[] @default([])

  latitude        Float?
  longitude       Float?

  status          String   @default("PENDING")
  grade           Int?
  feedback        String?
  annotations     Annotation[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model EvalSubmission {
  id              String   @id @default(cuid())
  agentId         String
  agent           User     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  taskId          String?
  task            CollectionTask? @relation(fields: [taskId], references: [id])

  modelName       String?
  promptText      String   @db.Text
  responseText    String   @db.Text

  overallRating   Int
  safetyRating    Int?
  factualRating   Int?
  domainRating    Int?

  hasSafetyIssue  Boolean  @default(false)
  safetyNote      String?
  language        String?
  domain          String?
  raterNotes      String?  @db.Text

  status          String   @default("SUBMITTED")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Annotation {
  id                String   @id @default(cuid())
  annotatorId       String
  annotator         User     @relation(fields: [annotatorId], references: [id], onDelete: Cascade)

  audioSubmissionId  String?
  audioSubmission    AudioSubmission? @relation(fields: [audioSubmissionId], references: [id])
  textSubmissionId   String?
  textSubmission     TextSubmission?  @relation(fields: [textSubmissionId], references: [id])
  videoSubmissionId  String?
  videoSubmission    VideoSubmission? @relation(fields: [videoSubmissionId], references: [id])

  grade           Int?
  approved        Boolean?
  notes           String?  @db.Text
  labels          String[] @default([])
  phoneticMarking String?
  culturalNote    String?

  createdAt       DateTime @default(now())
}
